{
  "name": "hr-etijah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Etijah HR — employee attendance & time tracking PWA (Nuxt 4 + Supabase)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > shared/types/database.ts",
    "pwa:assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "ipaddr.js": "^2.5.0",
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.3",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-postgis": "^0.2.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "pdfjs-dist": "^6.4.299",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
