# =============================================================================
# Etijah HR on Vercel — Production environment variables
# =============================================================================
# Enter these in Vercel → Project → Settings → Environment Variables, scope "Production".
# Do NOT copy values from your local .env: production gets its own secrets, generated fresh.
# Never commit real values. Mark every secret as "Sensitive" in Vercel.
#
# The server validates all of this when a function starts. With an invalid production
# configuration it refuses to start and the function logs (Vercel → Logs) name each setting.
# Vercel itself sets VERCEL=1, which the app uses to require the Vercel-specific settings below.
# Full guide: docs/DEPLOYMENT.md → "Vercel".
# =============================================================================

NUXT_APP_ENV=production

# --- Supabase ----------------------------------------------------------------
# Supabase Dashboard → Project Settings → API (Data API URL) and → API Keys.
NUXT_SUPABASE_URL=https://<project-ref>.supabase.co
# Public key (anon / publishable). Still used only by the server.
NUXT_SUPABASE_ANON_KEY=
# SECRET, server-only: service_role (legacy) or sb_secret_… key. Never prefix with NUXT_PUBLIC_.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# --- Session -----------------------------------------------------------------
# SECRET. 48 random bytes, new for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_SECRET=
NUXT_SESSION_ABSOLUTE_SECONDS=600
NUXT_SESSION_IDLE_SECONDS=600
NUXT_PUBLIC_SESSION_ABSOLUTE_SECONDS=600
NUXT_PUBLIC_SESSION_IDLE_SECONDS=600
# HTTPS only: Secure + __Host- session cookie. Required in production.
NUXT_COOKIE_SECURE=true

# --- App URL, CSRF and WebAuthn ------------------------------------------------
# The exact production URL(s), comma-separated. This is also the CSRF allow-list and the
# password-reset link base (first entry). Use the final domain BEFORE staff register devices:
# passkeys are bound to the RP ID, so changing the domain later means re-registering every device.
NUXT_WEBAUTHN_ORIGINS=https://hr.example.com
# Host of that origin (or a parent domain you own). On *.vercel.app it must be the full host
# (e.g. etijah-hr.vercel.app) — "vercel.app" itself is refused by browsers and by the app.
NUXT_WEBAUTHN_RP_ID=hr.example.com
NUXT_WEBAUTHN_RP_NAME=Etijah HR
NUXT_WEBAUTHN_CHALLENGE_TTL_SECONDS=90

# --- Client IP (company network check) -----------------------------------------
# vercel: the client IP comes from the address Vercel's edge writes into x-vercel-forwarded-for
# (cross-checked with x-real-ip / x-forwarded-for). Required on Vercel; refused anywhere else.
NUXT_TRUST_PROXY_MODE=vercel
NUXT_TRUSTED_PROXY_CIDRS=
NUXT_CLIENT_IP_HEADER=
# Local testing only — must stay EMPTY on Vercel (production refuses to start with it).
NUXT_DEV_LOOPBACK_CLIENT_IP=

# --- Rate limiting -------------------------------------------------------------
# database: shared counters in Supabase. Required on Vercel (many short-lived instances).
# Needs migration supabase/migrations/20261101000100_rate_limits.sql applied to the project;
# without it the app logs an error and falls back to per-instance memory counters.
NUXT_RATE_LIMIT_STORE=database

# --- Scheduled housekeeping (Vercel Cron) -----------------------------------------
# SECRET, 24+ random characters. Vercel sends it as "Authorization: Bearer …" to /api/cron/daily.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Build-time, optional. Default "0 21 * * *" (once a day, ~00:00 Baghdad) works on Hobby;
# on Pro you can match the Node server's schedule: */30 * * * *
# VERCEL_CRON_SCHEDULE=*/30 * * * *

# --- Web Push (optional) -----------------------------------------------------
# npx web-push generate-vapid-keys   (private key is a SECRET)
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:hr@example.com

NUXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Baghdad
