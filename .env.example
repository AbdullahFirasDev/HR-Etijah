# =============================================================================
# Etijah HR — environment configuration (copy to .env and fill in; never commit .env)
# All NUXT_* variables are read at runtime by the Nitro server and validated at startup:
# the terminal lists every missing/invalid setting by name (values are never printed).
# =============================================================================

# development | test | production. Default: development under `nuxi dev`, production for a build.
# Production refuses to start with an invalid configuration.
NUXT_APP_ENV=

# --- Supabase ----------------------------------------------------------------
# Project URL and keys: Supabase Dashboard → Project Settings → API.
# The service-role / secret key is SERVER-ONLY. It is never exposed to the browser.
NUXT_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Session -----------------------------------------------------------------
# 32+ random characters. Encrypts the stored Supabase token; rotate to invalidate all sessions.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_SECRET=
# Absolute lifetime and idle timeout in seconds (requirement: 600 / 600).
NUXT_SESSION_ABSOLUTE_SECONDS=600
NUXT_SESSION_IDLE_SECONDS=600
NUXT_PUBLIC_SESSION_ABSOLUTE_SECONDS=600
NUXT_PUBLIC_SESSION_IDLE_SECONDS=600
# Must be true in production (HTTPS). Enables the __Host- cookie prefix + Secure flag.
# Local http development: false (Safari refuses Secure cookies on http://localhost).
NUXT_COOKIE_SECURE=true

# --- WebAuthn ----------------------------------------------------------------
# RP ID = the app's host or a parent domain (no scheme/port), e.g. hr.etijah.com.
# Local development: localhost (open the app at http://localhost:3000, not 127.0.0.1).
NUXT_WEBAUTHN_RP_ID=hr.example.com
NUXT_WEBAUTHN_RP_NAME=Etijah HR
# Comma-separated exact origins the app is served from. This list is ALSO the CSRF allow-list:
# a POST from any other origin gets 403 csrf_origin_mismatch. Local development:
#   NUXT_WEBAUTHN_ORIGINS=http://localhost:3000
NUXT_WEBAUTHN_ORIGINS=https://hr.example.com
NUXT_WEBAUTHN_CHALLENGE_TTL_SECONDS=90

# --- Client IP resolution (network verification) ------------------------------
# none   : use the TCP peer address (app exposed directly)
# xff    : behind your own reverse proxy; peer must be in NUXT_TRUSTED_PROXY_CIDRS
# header : read a single-IP header written by your edge (cf-connecting-ip, x-real-ip, x-vercel-forwarded-for)
# See docs/SECURITY.md before changing. Never trust X-Forwarded-For from untrusted peers.
NUXT_TRUST_PROXY_MODE=none
NUXT_TRUSTED_PROXY_CIDRS=
NUXT_CLIENT_IP_HEADER=
# Local testing only. http://localhost reaches the server over loopback (127.0.0.1 / ::1), never through
# the office router, so it can never show the office public IP. Set this to the office public IP to have
# loopback requests network-checked as that address; it must still be in the allowed networks. Ignored
# outside loopback, and the server refuses to start with it when NUXT_APP_ENV=production. Example:
#   NUXT_DEV_LOOPBACK_CLIENT_IP=169.224.96.169
NUXT_DEV_LOOPBACK_CLIENT_IP=

# --- Scheduled jobs ----------------------------------------------------------
# Bearer secret for POST /api/cron/daily (24+ chars) when using an external scheduler.
NUXT_CRON_SECRET=

# --- Web Push (optional) -----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:hr@example.com

NUXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Baghdad
